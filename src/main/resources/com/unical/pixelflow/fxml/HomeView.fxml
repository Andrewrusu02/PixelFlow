<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="20" styleClass="background-1" xmlns="http://javafx.com/javafx/24" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.unical.pixelflow.controller.HomeViewController">
    <padding>
        <Insets bottom="30" left="40" right="40" top="30" />
    </padding>

    <Label fx:id="titleLabel" styleClass="text-title-home" text="Recent Projects" />

    <StackPane VBox.vgrow="ALWAYS">
        <!-- Messaggio centrato quando non ci sono progetti -->
        <VBox fx:id="emptyMessage" alignment="CENTER" style="-fx-background-color: transparent;">
            <Label fx:id="emptyTitleLabel" style="-fx-text-fill: #666; -fx-font-size: 18px; -fx-font-weight: bold;" text="Nessun progetto recente" />
            <Label fx:id="emptySubtitleLabel" style="-fx-text-fill: #888; -fx-font-size: 14px; -fx-padding: 10 0 0 0;" text="Clicca su '+ New Project' per iniziare" />
        </VBox>

        <!-- Griglia progetti (sopra al messaggio) -->
        <ScrollPane fitToHeight="true" fitToWidth="true" hbarPolicy="NEVER" style="-fx-background: transparent; -fx-background-color: transparent;">
            <FlowPane fx:id="projectsGrid" hgap="25" vgap="25">
                <padding>
                    <Insets bottom="10" left="0" right="0" top="10" />
                </padding>
            </FlowPane>
        </ScrollPane>
    </StackPane>
</VBox>
