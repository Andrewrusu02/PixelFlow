<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="20" style="-fx-background-color: #1E1E1E;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.unical.pixelflow.controller.HomeViewController">
    <padding>
        <Insets top="30" right="40" bottom="30" left="40"/>
    </padding>

    <Label fx:id="titleLabel" text="Recent Projects" style="-fx-text-fill: #E1C106; -fx-font-size: 28px; -fx-font-weight: bold;"/>

    <StackPane VBox.vgrow="ALWAYS">
        <!-- Messaggio centrato quando non ci sono progetti -->
        <VBox fx:id="emptyMessage" alignment="CENTER" style="-fx-background-color: transparent;">
            <Label fx:id="emptyTitleLabel" text="Nessun progetto recente" style="-fx-text-fill: #666; -fx-font-size: 18px; -fx-font-weight: bold;"/>
            <Label fx:id="emptySubtitleLabel" text="Clicca su '+ New Project' per iniziare" style="-fx-text-fill: #888; -fx-font-size: 14px; -fx-padding: 10 0 0 0;"/>
        </VBox>

        <!-- Griglia progetti (sopra al messaggio) -->
        <ScrollPane fitToWidth="true" fitToHeight="true" style="-fx-background: transparent; -fx-background-color: transparent;" hbarPolicy="NEVER">
            <FlowPane fx:id="projectsGrid" hgap="25" vgap="25" style="-fx-background-color: transparent;">
                <padding>
                    <Insets top="10" right="0" bottom="10" left="0"/>
                </padding>
            </FlowPane>
        </ScrollPane>
    </StackPane>
</VBox>
