<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" prefWidth="460" spacing="16" style="-fx-background-radius: 10;" styleClass="background-1" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1">

    <padding>
        <Insets bottom="26" left="26" right="26" top="26" />
    </padding>

    <Label fx:id="titleLabel" styleClass="card-title" text="ELIMINA PROGETTO" textAlignment="CENTER" />

    <Label fx:id="messageLabel" alignment="CENTER" textAlignment="CENTER" wrapText="true" />

    <Label fx:id="warningLabel" alignment="CENTER" text="Questa operazione è irreversibile." textAlignment="CENTER" />

    <HBox alignment="CENTER_RIGHT" spacing="15" VBox.vgrow="ALWAYS">
        <Button fx:id="btnCancel" maxWidth="1.7976931348623157E308" prefHeight="40.0" styleClass="transparent-button" text="Annulla" HBox.hgrow="ALWAYS" />
        <Button fx:id="btnConfirm" maxWidth="1.7976931348623157E308" prefHeight="40.0" styleClass="full-button" text="Elimina" HBox.hgrow="ALWAYS" />
    </HBox>
</VBox>
