<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="20" style="-fx-background-color: #1E1E1E; -fx-border-color: #444; -fx-border-width: 1;"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.unical.pixelflow.controller.NewProjectController">

    <padding><Insets top="30" right="30" bottom="30" left="30"/></padding>

    <Label fx:id="titleLabel" text="New Project" style="-fx-text-fill: #E1C106; -fx-font-size: 20px; -fx-font-weight: bold;"/>

    <VBox spacing="8">
        <Label fx:id="nameLabel" text="Project Name" style="-fx-text-fill: #AAAAAA;"/>
        <TextField fx:id="nameField" promptText="e.g. Vacation 2024"
                   style="-fx-background-color: #2D2D2D; -fx-text-fill: white; -fx-border-color: #555; -fx-border-radius: 4; -fx-background-radius: 4; -fx-padding: 8;"/>
    </VBox>

    <VBox spacing="8">
        <Label fx:id="sourceLabel" text="Source Image" style="-fx-text-fill: #AAAAAA;"/>
        <HBox spacing="10">
            <TextField fx:id="pathField" editable="false" HBox.hgrow="ALWAYS" promptText="No file selected"
                       style="-fx-background-color: #2D2D2D; -fx-text-fill: #888; -fx-border-color: #555; -fx-border-radius: 4; -fx-background-radius: 4; -fx-padding: 8;"/>
            <Button fx:id="browseButton" text="Browse..." onAction="#handleBrowse"
                    style="-fx-background-color: #444; -fx-text-fill: white; -fx-cursor: hand; -fx-padding: 8 20; -fx-background-radius: 4;"/>
        </HBox>
    </VBox>

    <HBox spacing="15" alignment="CENTER_RIGHT" style="-fx-padding: 10 0 0 0;">
        <Button fx:id="cancelButton" text="Cancel" onAction="#handleCancel"
                style="-fx-background-color: transparent; -fx-text-fill: #AAA; -fx-cursor: hand; -fx-padding: 8 20;"/>
        <Button fx:id="createButton" text="Create Project" onAction="#handleCreate"
                style="-fx-background-color: #E1C106; -fx-text-fill: black; -fx-font-weight: bold; -fx-background-radius: 4; -fx-cursor: hand; -fx-padding: 8 20;"/>
    </HBox>

</VBox>

