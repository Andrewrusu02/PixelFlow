<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="30.0" style="-fx-background-radius: 10;" styleClass="background-1" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.unical.pixelflow.controller.NewProjectController">

    <padding><Insets bottom="30" left="30" right="30" top="30" /></padding>

    <Label fx:id="titleLabel" styleClass="text-title" text="New Project" />

    <VBox spacing="8">
        <Label fx:id="nameLabel" text="Project Name" />
        <TextField fx:id="nameField" promptText="e.g. Vacation 2024" styleClass="text-field" />
    </VBox>

    <VBox spacing="8">
        <Label fx:id="sourceLabel" text="Source Image" />
        <HBox spacing="10">
            <TextField fx:id="pathField" editable="false" promptText="No file selected" styleClass="text-filed" HBox.hgrow="ALWAYS" />
            <Button fx:id="browseButton" maxHeight="1.7976931348623157E308" onAction="#handleBrowse" prefWidth="100.0" styleClass="full-button" text="Browse..." />
        </HBox>
    </VBox>

    <HBox alignment="CENTER" spacing="15" VBox.vgrow="ALWAYS">
        <Button fx:id="createButton" maxWidth="1.7976931348623157E308" onAction="#handleCreate" styleClass="full-button" text="Create Project" HBox.hgrow="ALWAYS" />
        <Button fx:id="cancelButton" maxWidth="1.7976931348623157E308" onAction="#handleCancel" style="-fx-text-fill: red;" styleClass="transparent-button" text="Cancel" HBox.hgrow="ALWAYS" />
      <VBox.margin>
         <Insets />
      </VBox.margin>
    </HBox>

</VBox>
