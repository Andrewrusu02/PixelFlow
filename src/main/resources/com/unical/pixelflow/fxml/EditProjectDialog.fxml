<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="20"
      style="-fx-background-color: #1E1E1E; -fx-border-color: #E1C106; -fx-border-width: 1;"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.unical.pixelflow.controller.EditProjectController"
      prefWidth="440">

    <padding>
        <Insets top="30" right="30" bottom="30" left="30"/>
    </padding>

    <Label fx:id="titleLabel" text="EDIT PROJECT"
           style="-fx-text-fill: white; -fx-font-size: 16px; -fx-font-weight: bold;"/>

    <VBox spacing="8">
        <Label fx:id="nameLabel" text="Project Name" style="-fx-text-fill: #AAAAAA;"/>
        <TextField fx:id="nameField"
                   style="-fx-background-color: #2D2D2D; -fx-text-fill: white; -fx-border-color: #555; -fx-border-radius: 4;"/>
    </VBox>

    <VBox spacing="8">
        <Label fx:id="sourceLabel" text="Source Image" style="-fx-text-fill: #AAAAAA;"/>
        <TextField fx:id="sourcePathField" editable="false" disable="true"
                   style="-fx-background-color: #252525; -fx-text-fill: #777; -fx-border-color: #333; -fx-border-radius: 4;"/>
    </VBox>

    <HBox spacing="15" alignment="CENTER_RIGHT" style="-fx-padding: 10 0 0 0;">
        <Button fx:id="cancelButton" text="Cancel" onAction="#handleCancel"
                style="-fx-background-color: transparent; -fx-text-fill: #AAA; -fx-cursor: hand; -fx-underline: true;"/>
        <Button fx:id="saveButton" text="Save" onAction="#handleSave"
                style="-fx-background-color: #E1C106; -fx-text-fill: black; -fx-font-weight: bold; -fx-background-radius: 4; -fx-cursor: hand;"/>
    </HBox>
</VBox>

