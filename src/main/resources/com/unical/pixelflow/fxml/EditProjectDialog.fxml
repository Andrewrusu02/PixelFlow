<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox prefWidth="440" spacing="20" style="-fx-background-radius: 10;" styleClass="background-1"  xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.unical.pixelflow.popUp.EditProjectController">

    <padding>
        <Insets bottom="30" left="30" right="30" top="30" />
    </padding>

    <Label fx:id="titleLabel" text="EDIT PROJECT" />

    <VBox spacing="8">
        <Label fx:id="nameLabel" text="Project Name" />
        <TextField fx:id="nameField" styleClass="text-field" />
    </VBox>

    <VBox spacing="8">
        <Label fx:id="sourceLabel" text="Source Image" />
        <TextField fx:id="sourcePathField" disable="true" editable="false" styleClass="text-field" />
    </VBox>

    <HBox alignment="CENTER" spacing="15" style="-fx-padding: 10 0 0 0;" VBox.vgrow="ALWAYS">
        <Button fx:id="saveButton" maxWidth="1.7976931348623157E308" onAction="#handleSave" prefHeight="40.0" prefWidth="40.0" styleClass="full-button" text="Save" HBox.hgrow="ALWAYS" />
        <Button fx:id="cancelButton" maxWidth="1.7976931348623157E308" onAction="#handleCancel" styleClass="transparent-button" text="Cancel" HBox.hgrow="ALWAYS" />
    </HBox>
</VBox>
