<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.SVGPath?>

<BorderPane fx:id="homeViewRoot" styleClass="background-1" xmlns="http://javafx.com/javafx/24" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.unical.pixelflow.controller.MainEditingController">

    <center>
        <StackPane fx:id="CenterNodePane" styleClass="background-1" BorderPane.alignment="CENTER">
        </StackPane>
    </center>

    <right>
      <VBox fx:id="RighPane" maxHeight="1.7976931348623157E308" maxWidth="-Infinity" minWidth="-Infinity" prefWidth="400.0" styleClass="background-2" BorderPane.alignment="CENTER" />
    </right>
   <left>
      <VBox fx:id="LeftPane" maxHeight="1.7976931348623157E308" maxWidth="-Infinity" minWidth="-Infinity" prefWidth="300.0" styleClass="background-3" BorderPane.alignment="CENTER">
         <children>
            <HBox alignment="CENTER_LEFT" maxHeight="-Infinity" minHeight="-Infinity" prefHeight="50.0" prefWidth="200.0" spacing="10.0" styleClass="background-1">
               <children>
                  <Button fx:id="buttonHome" maxHeight="-Infinity" minHeight="-Infinity" mnemonicParsing="false" onAction="#handleHome" prefHeight="40.0" prefWidth="50.0" styleClass="transparent-button">
                     <graphic>
                        <SVGPath content="M1 6V15H6V11C6 9.89543 6.89543 9 8 9C9.10457 9 10 9.89543 10 11V15H15V6L8 0L1 6Z" scaleX="1.2" scaleY="1.2" styleClass="icon_general" />
                     </graphic>
                  </Button>
                  <Separator orientation="VERTICAL" prefHeight="200.0" />
                  <HBox alignment="CENTER_LEFT" maxHeight="-Infinity" minHeight="-Infinity" prefHeight="40.0" spacing="10">
                     <children>
                        <TextField fx:id="pathField" alignment="CENTER" editable="false" maxHeight="-Infinity" minHeight="-Infinity" prefHeight="40.0" prefWidth="200.0" promptText="No file selected" styleClass="transparent-field" HBox.hgrow="ALWAYS" />
                        <Button fx:id="browseButton" maxHeight="-Infinity" minHeight="-Infinity" onAction="#handleBrowse" prefHeight="40.0" prefWidth="50.0" styleClass="transparent-button">
                           <graphic>
                              <SVGPath content="M6.29289 9.70711L11.2929 14.7071L12 15.4142L12.7071 14.7071L17.7071 9.70711L16.2929 8.29289L13 11.5858V4H18C19.1046 4 20 4.89543 20 6V18C20 19.1046 19.1046 20 18 20H6C4.89543 20 4 19.1046 4 18V6C4 4.89543 4.89543 4 6 4H11L11 11.5858L7.70711 8.29289L6.29289 9.70711Z" styleClass="icon_general" />
                           </graphic>
                        </Button>
                     </children>
                  </HBox>
               </children>
               <padding>
                  <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
               </padding>
            </HBox>
            <Separator prefWidth="200.0" />
         </children>
      </VBox>
   </left>

</BorderPane>
