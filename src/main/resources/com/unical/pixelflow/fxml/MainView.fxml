<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane fx:id="homeViewRoot" prefHeight="1080.0" prefWidth="1920.0" styleClass="background-1" stylesheets="@../css/style-dark.css" xmlns="http://javafx.com/javafx/24" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.unical.pixelflow.controller.MainEditingController">

    <center>
        <StackPane fx:id="CenterNodePane" styleClass="background-1" BorderPane.alignment="CENTER">
        </StackPane>
    </center>

    <left>
      <BorderPane fx:id="LeftPane" maxWidth="-Infinity" minWidth="-Infinity" prefWidth="350.0" styleClass="background-3" BorderPane.alignment="CENTER_LEFT">
         <top>
            <VBox fx:id="LibraryPanelPane" maxHeight="1.7976931348623157E308" minWidth="-Infinity" prefWidth="350.0" BorderPane.alignment="CENTER" />
         </top>
         <bottom>
            <StackPane fx:id="GraphPane" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="300.0" prefWidth="350.0" BorderPane.alignment="CENTER" />
         </bottom>
      </BorderPane>
    </left>

    <right>
      <BorderPane fx:id="RighPane" maxHeight="1.7976931348623157E308" maxWidth="-Infinity" minWidth="-Infinity" prefWidth="400.0" BorderPane.alignment="CENTER">
         <top>
                <BorderPane fx:id="PreviewPane" minHeight="300.0" prefHeight="350.0" BorderPane.alignment="CENTER" />
         </top>
         <bottom>

                      <BorderPane fx:id="ProprietiesPane" BorderPane.alignment="CENTER" />
         </bottom>
      </BorderPane>
    </right>

</BorderPane>
