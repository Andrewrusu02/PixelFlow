<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane fx:id="homeViewRoot" styleClass="background-1" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.unical.pixelflow.controller.MainEditingController">

    <center>
        <StackPane fx:id="CenterNodePane" styleClass="background-1" BorderPane.alignment="CENTER">
        </StackPane>
    </center>

    <left>
      <BorderPane fx:id="LeftPane" maxWidth="-Infinity" minWidth="-Infinity" prefWidth="300.0" styleClass="background-3" BorderPane.alignment="CENTER_LEFT">
         <top>
            <VBox fx:id="LibraryPanelPane" minWidth="-Infinity" prefWidth="300.0" BorderPane.alignment="CENTER" />
         </top>
         <bottom>
            <BorderPane fx:id="GraphPane" maxWidth="-Infinity" minWidth="-Infinity" prefHeight="250.0" prefWidth="300.0" BorderPane.alignment="CENTER" />
         </bottom>
      </BorderPane>
    </left>

    <right>
      <BorderPane fx:id="RighPane" maxHeight="1.7976931348623157E308" maxWidth="-Infinity" minWidth="-Infinity" prefWidth="300.0" styleClass="background-3" BorderPane.alignment="CENTER">
         <top>
                <BorderPane fx:id="PreviewPane" maxWidth="-Infinity" minHeight="300.0" prefHeight="350.0" BorderPane.alignment="CENTER" />
         </top>
         <bottom>

                      <BorderPane fx:id="ProprietiesPane" BorderPane.alignment="CENTER" />
         </bottom>
      </BorderPane>
    </right>

</BorderPane>
