        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
    <WebView fx:id="logoWebView" maxWidth="200.0" maxHeight="150.0" prefWidth="200.0" prefHeight="150.0" />
    <Label fx:id="welcomeText" text="Welcome to PixelFlow" />
   <VBox prefHeight="200.0" prefWidth="100.0" spacing="10.0">
      <children>
         <Button fx:id="loginHomeButton" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" mnemonicParsing="false" text="Go Login" />
         <Button fx:id="RegisterHomeButton" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" minHeight="-Infinity" minWidth="-Infinity" mnemonicParsing="false" text="Go Register" />
      </children>
   </VBox>
</VBox>
