<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<HBox alignment="CENTER" spacing="60" style="-fx-background-color: #1E1E1E;" stylesheets="@../css/style-dark.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.unical.pixelflow.controller.ProfileSettingsController">
    <padding>
        <Insets bottom="50" left="40" right="40" top="50" />
    </padding>

    <!-- Colonna Sinistra - Impostazioni Account -->
    <VBox alignment="TOP_LEFT" prefWidth="350" spacing="25">

        <Label fx:id="accountTitleLabel" style="-fx-text-fill: #E1C106; -fx-font-weight: bold; -fx-font-size: 20px;" text="ACCOUNT SETTINGS" />

        <!-- Avatar -->
        <VBox spacing="10">
            <Label fx:id="profileImageLabel" style="-fx-text-fill: #AAAAAA; -fx-font-size: 13px;" text="Profile Image" />
            <ImageView fx:id="profileImage" fitHeight="90" fitWidth="90" preserveRatio="true" pickOnBounds="true"
                       style="-fx-cursor: hand;">
                <clip>
                    <Circle centerX="45" centerY="45" radius="45" />
                </clip>
            </ImageView>
            <Button fx:id="changeAvatarButton" onAction="#handleChangeAvatar" text="Change image"
                    style="-fx-background-color: #444; -fx-text-fill: white; -fx-cursor: hand; -fx-padding: 8 14; -fx-background-radius: 5;" />
        </VBox>

        <VBox spacing="8">
            <Label fx:id="usernameLabel" style="-fx-text-fill: #AAAAAA; -fx-font-size: 13px;" text="Username" />
            <TextField fx:id="usernameField" editable="false" promptText="Username" style="-fx-background-color: #2D2D2D; -fx-text-fill: white; -fx-background-radius: 5; -fx-padding: 10; -fx-font-size: 14px; -fx-border-color: #444; -fx-border-radius: 5;" />
            <Label fx:id="userIdLabel" style="-fx-text-fill: #666; -fx-font-size: 11px;" text="ID: -" />
        </VBox>

        <Separator style="-fx-background-color: #444;" />

        <VBox spacing="8">
            <Label fx:id="languageLabel" style="-fx-text-fill: #AAAAAA; -fx-font-size: 13px;" text="Language" />
            <ComboBox fx:id="languageBox" prefWidth="350" style="-fx-background-color: #2D2D2D; -fx-mark-color: #E1C106;" />
        </VBox>

        <VBox spacing="12">
            <Label fx:id="themeLabel" style="-fx-text-fill: #AAAAAA; -fx-font-size: 13px;" text="Theme" />
            <ToggleButton fx:id="themeToggle" prefWidth="350" style="-fx-background-color: #2D2D2D; -fx-text-fill: white; -fx-padding: 10; -fx-background-radius: 5; -fx-border-color: #444; -fx-border-radius: 5;" text="Dark Mode: ON" />
            <Label fx:id="themeHintLabel" style="-fx-text-fill: #888; -fx-font-size: 10px; -fx-font-style: italic;" text="⚠ Theme change requires restart" />
        </VBox>

    </VBox>

    <!-- Colonna Destra - Cambio Password -->
    <VBox alignment="TOP_LEFT" prefWidth="350" spacing="20" style="-fx-background-color: #2D2D2D; -fx-padding: 30; -fx-background-radius: 15;">

        <Label fx:id="securityTitleLabel" style="-fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 16px;" text="SECURITY" />

        <Label fx:id="changePasswordLabel" style="-fx-text-fill: #AAAAAA; -fx-font-size: 13px;" text="Change Password" />

        <VBox spacing="8">
            <Label fx:id="newPasswordLabel" style="-fx-text-fill: #AAAAAA; -fx-font-size: 12px;" text="New Password" />
            <PasswordField fx:id="newPass" promptText="Enter new password" style="-fx-background-color: #1E1E1E; -fx-text-fill: white; -fx-border-color: #555; -fx-border-radius: 5; -fx-background-radius: 5; -fx-padding: 10;" />
        </VBox>

        <VBox spacing="8">
            <Label fx:id="confirmPasswordLabel" style="-fx-text-fill: #AAAAAA; -fx-font-size: 12px;" text="Confirm Password" />
            <PasswordField fx:id="confirmPass" promptText="Confirm password" style="-fx-background-color: #1E1E1E; -fx-text-fill: white; -fx-border-color: #555; -fx-border-radius: 5; -fx-background-radius: 5; -fx-padding: 10;" />
        </VBox>

        <Separator style="-fx-background-color: #444;" />

        <Button fx:id="saveButton" maxWidth="Infinity" onAction="#handleSave" style="-fx-background-color: #E1C106; -fx-text-fill: black; -fx-font-weight: bold; -fx-cursor: hand; -fx-padding: 12; -fx-font-size: 14px; -fx-background-radius: 5;" text="Save" />

        <Label fx:id="statusLabel" style="-fx-text-fill: #4CAF50; -fx-font-size: 12px; -fx-font-weight: bold;" text="" wrapText="true" />
    </VBox>

</HBox>
